{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "expo": "~54.0.36",
    "expo-blur": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-is": "^19.2.8",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0"
  },
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File start-expo.ps1",
    "start:clear": "powershell -ExecutionPolicy Bypass -File start-expo.ps1 --clear",
    "tunnel": "expo start --tunnel",
    "tunnel:clear": "expo start --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "test:run": "jest --watchAll=false"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ],
          "presets": []
        }
      ]
    },
    "transformIgnorePatterns": [],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/src/utils/__mocks__/async-storage.js",
      "^react-native$": "<rootDir>/src/utils/__mocks__/react-native.js",
      "^../services/supabase$": "<rootDir>/src/utils/__mocks__/supabase.js",
      "^../../services/supabase$": "<rootDir>/src/utils/__mocks__/supabase.js",
      "^\\./supabase$": "<rootDir>/src/utils/__mocks__/supabase.js",
      "^expo-notifications$": "<rootDir>/src/utils/__mocks__/expo-notifications.js",
      "^expo-device$": "<rootDir>/src/utils/__mocks__/expo-device.js"
    }
  },
  "private": true,
  "devDependencies": {
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
