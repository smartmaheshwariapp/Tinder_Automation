{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-config": "~57.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-is": "^19.2.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File start-expo.ps1",
    "start:clear": "powershell -ExecutionPolicy Bypass -File start-expo.ps1 --clear",
    "tunnel": "expo start --tunnel",
    "tunnel:clear": "expo start --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "test:run": "jest --watchAll=false"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ],
          "presets": []
        }
      ]
    },
    "transformIgnorePatterns": [],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/src/utils/__mocks__/async-storage.js",
      "^react-native$": "<rootDir>/src/utils/__mocks__/react-native.js",
      "^../services/supabase$": "<rootDir>/src/utils/__mocks__/supabase.js",
      "^../../services/supabase$": "<rootDir>/src/utils/__mocks__/supabase.js",
      "^\\./supabase$": "<rootDir>/src/utils/__mocks__/supabase.js",
      "^expo-notifications$": "<rootDir>/src/utils/__mocks__/expo-notifications.js",
      "^expo-device$": "<rootDir>/src/utils/__mocks__/expo-device.js"
    }
  },
  "private": true,
  "devDependencies": {
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
