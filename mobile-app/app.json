{
  "expo": {
    "name": "Flint",
    "slug": "flint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flirteasy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Flint uses your location to discover local dating matches and automatically synchronize your recommendation deck.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Flint uses your location to optimize your dating matches.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.flirteasy.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "60d1aae8-292b-4e3f-83e9-37949213bba2"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/60d1aae8-292b-4e3f-83e9-37949213bba2"
    },
    "plugins": [
      "expo-web-browser",
      "expo-location",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
