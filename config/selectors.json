      "svg[aria-label*='Messages' i]",
      "a[href*='/messages']",
      "nav a:nth-child(2)"
    ],
    "profile": [
      "a[href='/app/profile']",
      "a[href*='/profile']"
    ]
  },
  "messaging": {
