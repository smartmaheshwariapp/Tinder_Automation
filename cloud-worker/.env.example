# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Redis (BullMQ job queue) ──────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Session storage ───────────────────────────────────────────────────────────
# Absolute path on server where per-user browser profiles are stored
SESSIONS_DIR=/var/flirteasy/sessions

# ── FlirtEasy backend ─────────────────────────────────────────────────────────
# Your existing Cloudflare Worker URL
FLIRTEASY_API_URL=https://flirteasy-auth.shnaiderdm.workers.dev
# Internal secret so the cloud worker can call your API with elevated trust
CLOUD_WORKER_SECRET=your_internal_secret_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign time-limited login URLs
LOGIN_URL_SECRET=change_this_to_a_random_32char_string

# ── Proxy (Oxylabs residential) ───────────────────────────────────────────────
PROXY_HOST=pr.oxylabs.io
PROXY_PORT=7777
PROXY_USERNAME=your_oxylabs_username
PROXY_PASSWORD=your_oxylabs_password
# Country code for residential IPs — match your user's region or target region
PROXY_COUNTRY=US

# ── noVNC login server ────────────────────────────────────────────────────────
# Public URL of this cloud worker server (used to build login URLs)
PUBLIC_URL=https://cloud.flirteasy.com
# noVNC websockify port range start (each user gets a port)
NOVNC_PORT_START=5900

# ── Timeouts ─────────────────────────────────────────────────────────────────
# How long a login URL stays valid (seconds)
LOGIN_URL_TTL_SECONDS=600
# How long before we consider a session stale and re-check (ms)
SESSION_HEALTH_CHECK_INTERVAL_MS=60000
