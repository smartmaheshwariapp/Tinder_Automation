# Public origin used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# The domain below is inferred from the support address used in the app (support@flint.dating).
# Confirm it before deploying.
VITE_SITE_URL=https://flint.dating

# Endpoint that receives contact-form submissions as JSON: { name, email, subject, message }.
# Leave empty until a backend or form service exists; the form then shows an error with an email fallback.
VITE_CONTACT_ENDPOINT=
